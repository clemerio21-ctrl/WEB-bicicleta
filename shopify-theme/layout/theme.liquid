<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
<link rel="canonical" href="{{ canonical_url }}">
{% if settings.favicon %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">{% endif %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

{{ content_for_header }}

{{ 'theme.css' | asset_url | stylesheet_tag }}
<style>
  :root {
    --c-accent: {{ settings.color_accent | default: '#ff4b1f' }};
    --c-accent-dark: {{ settings.color_accent | color_darken: 15 }};
    --c-accent-light: {{ settings.color_accent | color_lighten: 15 }};
    --c-accent-soft: {{ settings.color_accent | color_modify: 'alpha', 0.12 }};
    --c-ink: {{ settings.color_ink | default: '#121214' }};
    --c-white: {{ settings.color_background | default: '#f7f6f3' }};
  }
</style>
</head>
<body>

{% section 'announcement-bar' %}
{% section 'header' %}

<main id="main-content">
  {{ content_for_layout }}
</main>

{% section 'footer' %}

<!-- ============ Search overlay ============ -->
<div class="search-overlay" id="searchOverlay">
  <button class="search-close" id="searchClose" aria-label="Cerrar búsqueda" type="button">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
  <div class="search-panel">
    <form class="search-box" action="{{ routes.search_url }}" method="get" role="search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="search" name="q" id="searchInput" placeholder="Buscar tricotas, calzas, guantes..." autocomplete="off" value="{{ search.terms | escape }}" />
    </form>
    <p class="search-hint">Escribe y presiona Enter para ver los resultados.</p>
  </div>
</div>

<!-- ============ Toast ============ -->
<div class="toast" id="toast">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
  <span id="toastMsg">Producto agregado</span>
</div>

{{ 'theme.js' | asset_url | script_tag }}
</body>
</html>
