{% assign current_variant = product.selected_or_first_available_variant %}

<div class="container">
  <nav class="breadcrumb" aria-label="Ruta de navegación">
    <a href="{{ routes.root_url }}">Inicio</a>
    <span class="sep">/</span>
    {% if collection %}
      <a href="{{ collection.url }}">{{ collection.title }}</a>
      <span class="sep">/</span>
    {% endif %}
    <span class="current">{{ product.title }}</span>
  </nav>
</div>

<section class="pdp">
  <div class="container">
    <div class="pdp-grid" data-product-form>

      <script type="application/json" data-product-json>{{ product.variants | json }}</script>

      <!-- Gallery -->
      <div class="pdp-gallery">
        <div class="pdp-gallery-main" data-gallery-main>
          {% if product.featured_image %}
            <img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" />
          {% else %}
            <div style="width:100%;height:100%;background:var(--c-card);"></div>
          {% endif %}
        </div>
        {% if product.images.size > 1 %}
          <div class="pdp-thumbs">
            {% for image in product.images limit: 5 %}
              <button class="pdp-thumb{% if forloop.first %} active{% endif %}" type="button" data-thumb data-full="{{ image | image_url: width: 900 }}" aria-label="Ver foto {{ forloop.index }}">
                <img src="{{ image | image_url: width: 150 }}" alt="" style="width:100%;height:100%;object-fit:cover;" />
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- Info -->
      <div class="pdp-info">
        {% if product.tags contains 'más vendida' or product.tags contains 'bestseller' %}
          <span class="product-badge accent">Más vendida</span>
        {% elsif product.tags contains 'nuevo' or product.tags contains 'new' %}
          <span class="product-badge">Nuevo</span>
        {% endif %}

        <h1 class="pdp-title">{{ product.title }}</h1>
        <p class="pdp-price">
          <span data-price>{{ current_variant.price | money }}</span>
          <span class="price-compare" data-compare-price {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</span>
        </p>

        {% if product.description != blank %}
          <div class="pdp-desc">{{ product.description }}</div>
        {% endif %}

        {% form 'product', product, class: 'js-add-cart-form', data-product-title: product.title %}
          <input type="hidden" name="id" value="{{ current_variant.id }}">

          {% for option in product.options_with_values %}
            <div class="pdp-option">
              <div class="pdp-option-head">
                <span class="label">{{ option.name }}</span>
                {% if option.name == 'Talla' or option.name == 'Size' %}<a href="#guia-de-talles" class="guide">Guía de talles</a>{% endif %}
              </div>
              <div class="{% if option.name == 'Color' %}pdp-colors{% else %}pdp-sizes{% endif %}" data-option-index="{{ forloop.index0 }}">
                {% for value in option.values %}
                  {% if option.name == 'Color' %}
                    {% capture swatch_hex %}{% render 'color-swatch-hex', name: value %}{% endcapture %}
                    <button type="button" class="pdp-color{% if current_variant.options[forloop.parentloop.index0] == value %} is-selected{% endif %}" data-value="{{ value | escape }}"><span style="background:{{ swatch_hex | strip }};"></span></button>
                  {% else %}
                    <button type="button" class="pdp-size{% if current_variant.options[forloop.parentloop.index0] == value %} is-selected{% endif %}" data-value="{{ value | escape }}">{{ value }}</button>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% endfor %}

          <div class="pdp-option">
            <div class="pdp-option-head"><span class="label">Cantidad</span></div>
            <div class="pdp-qty" data-qty>
              <button type="button" data-qty-minus aria-label="Restar">−</button>
              <input type="number" name="quantity" value="1" min="1" data-qty-input style="width:44px;text-align:center;border:none;background:none;font-weight:700;" />
              <button type="button" data-qty-plus aria-label="Sumar">+</button>
            </div>
          </div>

          <div class="pdp-actions">
            <button type="submit" class="btn btn-dark" data-add-submit
              data-label-available="Agregar al carrito"
              data-label-sold-out="Agotado"
              {% unless current_variant.available %}disabled{% endunless %}>
              {% if current_variant.available %}Agregar al carrito{% else %}Agotado{% endif %}
            </button>
          </div>
          <div class="pdp-actions" style="margin-top:14px;">
            {{ form | payment_button }}
          </div>
        {% endform %}

        <div class="pdp-meta">
          <div class="pdp-meta-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            {{ section.settings.shipping_note | default: 'Envío estimado 2-4 días hábiles a todo Chile.' }}
          </div>
          <div class="pdp-meta-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/><polyline points="21 3 21 9 15 9"/></svg>
            {{ section.settings.returns_note | default: 'Cambios y devoluciones dentro de 30 días.' }}
          </div>
        </div>

        <div class="accordion" id="guia-de-talles">
          {% if section.settings.materials_content != blank %}
            <div class="accordion-item">
              <button class="accordion-btn" type="button" data-accordion>
                Materiales y cuidado
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
              <div class="accordion-panel">{{ section.settings.materials_content }}</div>
            </div>
          {% endif %}
          {% if section.settings.size_guide_content != blank %}
            <div class="accordion-item">
              <button class="accordion-btn" type="button" data-accordion>
                Guía de talles
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
              <div class="accordion-panel">{{ section.settings.size_guide_content }}</div>
            </div>
          {% endif %}
          {% if section.settings.shipping_content != blank %}
            <div class="accordion-item">
              <button class="accordion-btn" type="button" data-accordion>
                Envíos y devoluciones
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
              <div class="accordion-panel">{{ section.settings.shipping_content }}</div>
            </div>
          {% endif %}
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Producto",
  "settings": [
    { "type": "text", "id": "shipping_note", "label": "Nota de envío", "default": "Envío estimado 2-4 días hábiles a todo Chile." },
    { "type": "text", "id": "returns_note", "label": "Nota de cambios", "default": "Cambios y devoluciones dentro de 30 días." },
    { "type": "richtext", "id": "materials_content", "label": "Acordeón — Materiales y cuidado" },
    { "type": "richtext", "id": "size_guide_content", "label": "Acordeón — Guía de talles" },
    { "type": "richtext", "id": "shipping_content", "label": "Acordeón — Envíos y devoluciones", "default": "<p>Envío gratis en compras sobre $50.000. Retiro gratuito en tienda (Santiago). Devoluciones dentro de 30 días desde la recepción.</p>" }
  ]
}
{% endschema %}
