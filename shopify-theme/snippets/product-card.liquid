{% comment %}
  Renders one product card, matching the Vortex Crew demo design.
  Usage: {% render 'product-card', product: product %}
{% endcomment %}

<a href="{{ product.url }}" class="product-card" data-reveal>
  <div class="product-media">
    {% if product.compare_at_price > product.price %}
      <span class="product-badge accent">Oferta</span>
    {% elsif product.tags contains 'nuevo' or product.tags contains 'new' %}
      <span class="product-badge">Nuevo</span>
    {% elsif product.tags contains 'más vendida' or product.tags contains 'bestseller' %}
      <span class="product-badge accent">Más vendida</span>
    {% endif %}

    {% if product.featured_image %}
      <img
        src="{{ product.featured_image | image_url: width: 700 }}"
        alt="{{ product.featured_image.alt | default: product.title | escape }}"
        loading="lazy"
        width="700" height="875"
      />
      {% if product.images.size > 1 %}
        <img
          src="{{ product.images[1] | image_url: width: 700 }}"
          alt=""
          loading="lazy"
          width="700" height="875"
        />
      {% endif %}
    {% else %}
      <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:var(--c-muted);font-size:13px;">Sin imagen</div>
    {% endif %}

    <button class="product-quick" type="button" aria-label="Vista rápida" data-quickview>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
    </button>
  </div>

  <div class="product-info">
    <h3 class="product-name">{{ product.title }}</h3>
    <p class="product-price">
      {{ product.price | money }}
      {% if product.compare_at_price > product.price %}
        <span class="price-compare">{{ product.compare_at_price | money }}</span>
      {% endif %}
    </p>

    {% for option in product.options_with_values %}
      {% if option.name == 'Talla' or option.name == 'Size' %}
        <div class="option-row">
          <span class="option-label">Talla</span>
          <div class="size-pills">
            {% for value in option.values limit: 5 %}
              <span class="size-pill">{{ value }}</span>
            {% endfor %}
          </div>
        </div>
      {% endif %}
      {% if option.name == 'Color' %}
        <div class="option-row">
          <span class="option-label">Color</span>
          <div class="color-dots">
            {% for value in option.values limit: 4 %}
              {% capture swatch_hex %}{% render 'color-swatch-hex', name: value %}{% endcapture %}
              <span class="color-dot" aria-label="{{ value }}"><span style="background:{{ swatch_hex | strip }};"></span></span>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    {% endfor %}

    {% if product.has_only_default_variant %}
      <form data-add-cart-form data-product-title="{{ product.title | escape }}" action="{{ routes.cart_add_url }}" method="post">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button class="product-add" type="submit" {% unless product.available %}disabled{% endunless %}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          {% if product.available %}Agregar{% else %}Agotado{% endif %}
        </button>
      </form>
    {% else %}
      <span class="product-add">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
        {% if product.available %}Ver producto{% else %}Agotado{% endif %}
      </span>
    {% endif %}
  </div>
</a>
